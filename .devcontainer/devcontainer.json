{
    "name": "Personal Website Dev Container",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "extensions": [
                "esbenp.prettier-vscode"
            ]
        }
    },
    "remoteUser": "root",
    "onCreateCommand": "/bin/bash /tmp/bootstrap/bootstrap.sh",
    "postCreateCommand": "/bin/bash /tmp/bootstrap/cleanup.sh"

}