{
    "name": "Personal Website Dev Container",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspace",

    "customizations": {
        "vscode": {
            "settings": {
                "terminal.intergrated.defaultProfile.linux": "bash",
                "terminal.intergated.profiles.linux": {
                    "bash": {
                        "path": "bash"
                    }
                }
            },
            "extensions": [
                "esbenp.prettier-vscode",
            ]
        }
    },
    "remoteUser": "root"
}