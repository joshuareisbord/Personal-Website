# Public Firebase web-app configuration. Copy to .env.local for local development.
# These VITE_* values are compiled into browser assets; never put private keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Local testing only. Use a demo project and start Auth/Firestore/Storage emulators first.
# Rejected away from localhost/loopback; CMS initialization fails closed.
# Keep false for hosted builds.
VITE_USE_FIREBASE_EMULATORS=false
