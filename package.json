{
  "name": "personal-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "vite --host 127.0.0.1",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && tsx scripts/prerender.ts && tsx scripts/verify-output.ts",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/content/*.test.ts tests/render/*.test.ts",
    "verify": "npm run check && npm test && npm run build",
    "hosting:preview": "firebase emulators:start --only hosting",
    "test:rules": "firebase emulators:exec --only firestore --project demo-personal-website \"tsx --test tests/cms/firestore.test.ts\"",
    "cms:emulators": "firebase emulators:start --only auth,firestore --project demo-personal-website",
    "deploy:rules": "firebase deploy --only firestore:rules --project personal-website-f17c6",
    "cms:seed": "tsx scripts/seed-emulator.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.29.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
