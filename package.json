{
  "name": "personal-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.8.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "vite --host 127.0.0.1",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && tsx scripts/prerender.ts && tsx scripts/verify-output.ts",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/content/*.test.ts tests/render/*.test.ts",
    "verify": "npm run check && npm test && npm run build",
    "hosting:preview": "firebase emulators:start --only hosting",
    "test:rules": "firebase emulators:exec --only firestore --project demo-personal-website \"tsx --test tests/cms/firestore.test.ts\"",
    "cms:emulators": "firebase emulators:start --only auth,firestore --project demo-personal-website",
    "deploy:rules": "firebase deploy --only firestore:rules --project personal-website-f17c6",
    "cms:seed": "tsx scripts/seed-emulator.ts",
    "geography:prepare": "tsx scripts/prepare-geography.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "d3-geo": "^3.1.1",
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "topojson-client": "^3.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "country-state-city": "^3.2.1",
    "firebase-tools": "^15.29.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "overrides": {
    "firebase-tools": {
      "superstatic": "11.0.0"
    }
  }
}
